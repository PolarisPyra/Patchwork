#!/usr/bin/env bash
# Git runs this before each push once `git config core.hooksPath scripts/hooks` is set. It runs the
# quick checks CI starts with, on the files as they are in the working tree, so a push that CI
# would turn down for formatting or a lint stops here in a few seconds. Tag-only pushes and branch
# deletions skip the checks. CI still runs the tests. `git push --no-verify` skips it.
set -euo pipefail

if [[ ! -t 0 ]]; then
  has_branch_push=0
  while read -r _local_ref local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
      refs/tags/*) continue ;;
    esac
    if [[ "$local_sha" =~ ^0+$ ]]; then
      continue
    fi
    has_branch_push=1
  done
  if [[ "$has_branch_push" -eq 0 ]]; then
    exit 0
  fi
fi

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: cargo fmt --all -- --check"
cargo fmt --all -- --check

echo "pre-push: cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

echo "pre-push: node --check on the website's script"
node --check site/site.js
