#!/usr/bin/env bash
# Git runs this before each push once `git config core.hooksPath scripts/hooks` is set. It runs the
# two quick checks CI starts with, on the files as they are in the working tree, so a push that CI
# would turn down for formatting or a lint stops here in a few seconds. CI still runs the tests.
# `git push --no-verify` skips it.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: cargo fmt --all -- --check"
cargo fmt --all -- --check

echo "pre-push: cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

echo "pre-push: node --check on the website's scripts"
node --check site/site.js
node --check site/refresh-downloads.mjs
