#!/usr/bin/env bash
# Git runs this before any push once `git config core.hooksPath scripts/hooks` is set, which
# `pnpm install` does. A push is the user's call, so this stops one that was not asked for.
#
# To push on purpose, say so in the conversation. To push from a terminal yourself, either use
# `git push --no-verify` or set PATCHWORK_PUSH=1.
set -euo pipefail

if [[ "${PATCHWORK_PUSH:-}" == "1" ]]; then
  exit 0
fi

cat >&2 <<'EOF'
Stopped: this push was not asked for.

Pushing is the user's call, not the agent's. Commit locally and say the work is unpushed.

The user, or anyone at a terminal, can push with:
    PATCHWORK_PUSH=1 git push
    git push --no-verify
EOF
exit 1
