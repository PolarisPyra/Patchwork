{
  "name": "@patchwork/monorepo",
  "version": "0.10.36",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter patchwork-desktop dev",
    "dev:web": "pnpm --filter patchwork-web dev",
    "build": "pnpm --filter patchwork-desktop build",
    "typecheck": "pnpm --filter patchwork-web typecheck",
    "test": "cargo test --workspace",
    "prepare": "git config core.hooksPath scripts/hooks || true",
    "release": "scripts/release.sh",
    "tauri": "pnpm --filter patchwork-desktop tauri",
    "format": "prettier --write --log-level warn \"apps/**/*.tsx\"",
    "format:check": "prettier --check \"apps/**/*.tsx\"",
    "types": "cargo run -q -p patchwork-server --example export_types",
    "check": "pnpm types && pnpm typecheck && pnpm format:check && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
